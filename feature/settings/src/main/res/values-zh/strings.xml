    <!-- 首次启动后台保活引导 -->
    <string name="onboarding_title">让容器在后台持续运行</string>
    <string name="onboarding_desc">Android 系统以及国内厂商定制 ROM 会积极查杀后台应用。只有授予后台运行权限，容器与 Docker 服务才能在退后台后继续运行。请完成以下三步（之后可在设置中随时修改）。</string>
    <string name="onboarding_step_notifications">通知权限</string>
    <string name="onboarding_step_notifications_desc">显示保活前台服务的常驻通知（Android 13 及以上必须授权）。</string>
    <string name="onboarding_step_battery">忽略电池优化</string>
    <string name="onboarding_step_battery_desc">将应用加入电池优化白名单，避免熄屏后进入 Doze 模式导致容器被冻结或停止。</string>
    <string name="onboarding_step_vendor">厂商自启动设置</string>
    <string name="onboarding_step_vendor_desc">打开本机系统的后台设置页，允许本应用自启动并在后台运行。</string>
    <string name="onboarding_ready_title">一切就绪</string>
    <string name="onboarding_ready_desc">以上配置可随时在「设置 → 后台运行」中查看或修改。保活通知显示期间，容器会持续在后台运行。</string>
