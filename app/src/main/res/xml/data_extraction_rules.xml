<?xml version="1.0" encoding="utf-8"?><!--
  云备份 / 换机迁移排除规则（API 31+；API 30 及以下见 backup_rules.xml）。

  审查 P1-4：理由同 backup_rules.xml —— DataStore 存远程控制端口的 Bearer token
  （端口无 TLS，token 即容器控制权），logs 与 engine（rootfs，百 MB 级）也无迁移价值。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="logs" />
        <exclude domain="file" path="engine" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="logs" />
        <exclude domain="file" path="engine" />
    </device-transfer>
</data-extraction-rules>
